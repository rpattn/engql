# --- Build Stage ---
FROM golang:1.21-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /engql-api ./cmd/server/main.go

# --- Run Stage ---
FROM alpine:latest
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata
# Copy the binary
COPY --from=builder /engql-api .
# CRITICAL: Copy migrations folder so the app can run them on startup
COPY --from=builder /app/migrations ./migrations
# Copy any default config if needed (though we use Env Vars)
# COPY --from=builder /app/config.yaml . 

EXPOSE 8080
CMD ["./engql-api"]